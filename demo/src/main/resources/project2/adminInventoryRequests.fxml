<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="project2.AdminInventoryRequestsController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="24.0"/>
            </padding>
            <Label text="Inventory Request Management" textFill="#2699a1">
                <font>
                    <Font name="System Bold" size="26.0"/>
                </font>
            </Label>
            <Label text="Review and approve inventory requests from pharmacists"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" BorderPane.alignment="CENTER">
            <VBox spacing="25.0">
                <padding>
                    <Insets left="24.0" right="24.0" top="10.0" bottom="20.0"/>
                </padding>

                <!-- Pending Requests Section -->
                <VBox spacing="12.0" style="-fx-border-color: #ff9800; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;">
                    <Label text="⏳ Pending Requests" textFill="#ff9800">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <Label text="Review and approve/deny pending inventory requests" textFill="#666666"/>

                    <TableView fx:id="pendingRequestsTable" prefHeight="300.0">
                        <columns>
                            <TableColumn fx:id="pharmacistColumn" prefWidth="120.0" text="Pharmacist"/>
                            <TableColumn fx:id="itemColumn" prefWidth="120.0" text="Item Name"/>
                            <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantity"/>
                            <TableColumn fx:id="reasonColumn" prefWidth="250.0" text="Reason"/>
                            <TableColumn fx:id="dateColumn" prefWidth="130.0" text="Request Date"/>
                            <TableColumn fx:id="actionsColumn" prefWidth="180.0" text="Actions"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- All Requests History Section -->
                <VBox spacing="12.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;">
                    <Label text="📋 All Requests History" textFill="#2699a1">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <Label text="Complete history of all inventory requests" textFill="#666666"/>

                    <TableView fx:id="allRequestsTable" prefHeight="300.0">
                        <columns>
                            <TableColumn fx:id="allPharmacistColumn" prefWidth="110.0" text="Pharmacist"/>
                            <TableColumn fx:id="allItemColumn" prefWidth="110.0" text="Item Name"/>
                            <TableColumn fx:id="allQuantityColumn" prefWidth="70.0" text="Quantity"/>
                            <TableColumn fx:id="allStatusColumn" prefWidth="90.0" text="Status"/>
                            <TableColumn fx:id="allDateColumn" prefWidth="130.0" text="Request Date"/>
                            <TableColumn fx:id="reviewedByColumn" prefWidth="110.0" text="Reviewed By"/>
                            <TableColumn fx:id="adminNotesColumn" prefWidth="220.0" text="Admin Notes"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="12.0"/>
            </padding>
            <Button fx:id="backButton" text="← Back to Admin Dashboard" onAction="#goBack"/>
            <Button fx:id="viewInventoryButton" text="📦 View Inventory" onAction="#viewInventory"/>
            <Button fx:id="refreshButton" text="🔄 Refresh Data" onAction="#refreshData"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
