<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="project2.PharmacistDashboardController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="6.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="24.0"/>
            </padding>
            <children>
                <Label text="Pharmacist Portal" textFill="#2699a1">
                    <font>
                        <Font name="System Bold" size="26.0"/>
                    </font>
                </Label>
                <Label text="Welcome,"/>
                <Label fx:id="pharmacistNameLabel" text="Pharmacist">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="User ID:"/>
                        <Label fx:id="pharmacistIdLabel" text="id"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="24.0" right="24.0"/>
            </padding>
            <children>
                <Label text="Assigned Patients &amp; Medications">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
                <TableView fx:id="assignmentsTable" prefHeight="420.0">
                    <columns>
                        <TableColumn fx:id="patientColumn" prefWidth="220.0" text="Patient Username"/>
                        <TableColumn fx:id="medicationColumn" prefWidth="320.0" text="Medication"/>
                        <TableColumn fx:id="quantityColumn" prefWidth="140.0" text="Quantity"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="12.0"/>
            </padding>
            <children>
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshAssignments" text="Refresh"/>
                <Button fx:id="addTestButton" mnemonicParsing="false" onAction="#openAddTestForm" text="Add Test"/>
                <Button fx:id="viewTestHistoryButton" mnemonicParsing="false" onAction="#viewTestHistory" text="View Test History"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="changePasswordButton" text="Change Password" onAction="#goChangePassword"/>
                <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logout" text="Log Out"/>
                <Button fx:id="btnDeleteMyAccount" text="Delete My Account" onAction="#onDeleteMyAccount"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
