<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane id="topLabel" fx:id="topLabel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
            minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="project2.LogInController">
    <children>
        <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Close"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Delete"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" text="About"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <StackPane fx:id="PaneLabel" prefHeight="400.0" prefWidth="600.0" AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <!-- LOGIN PANEL -->
                <VBox fx:id="loginPanel" spacing="10" alignment="CENTER">
                    <Label text="Clinical Laboratory Management System" textFill="#2699a1" wrapText="true">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <Label text="Enter Log In Credentials Below" wrapText="true"/>
                    <TextField fx:id="usernameText" promptText="username" maxWidth="200"/>
                    <PasswordField fx:id="passwordText" promptText="password" maxWidth="200"/>
                    <Button fx:id="LogInButton" text="Enter" mnemonicParsing="false" onAction="#doLogin"
                            prefWidth="100"/>
                    <Button fx:id="showRegisterButton" text="Register" onAction="#showRegisterPanel" prefWidth="100"/>
                    <Label fx:id="loginWarnings" text="Wrong username or password!" textFill="#b21818"
                           visible="false" wrapText="true"/>
                </VBox>
                <!-- REGISTRATION PANEL -->
                <VBox fx:id="registerPanel" spacing="10" alignment="CENTER" visible="false">
                    <Label text="Create New Account" textFill="#2699a1" wrapText="true">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>
                    <TextField fx:id="regUsername" promptText="username" maxWidth="200"/>
                    <PasswordField fx:id="regPassword" promptText="password" maxWidth="200"/>
                    <PasswordField fx:id="regPasswordConfirmation" promptText="password" maxWidth="200"/>
                    <Button fx:id="registerButton" text="Register" onAction="#doRegister" prefWidth="100"/>
                    <Button fx:id="backToLoginButton" text="Back to Login" onAction="#showLoginPanel" prefWidth="100"/>
                    <Label fx:id="registerWarnings" textFill="#b21818"
                           visible="false" wrapText="true"/>
                </VBox>
            </children>
        </StackPane>

    </children>
</AnchorPane>
