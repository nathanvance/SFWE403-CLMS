<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="adminDashboardPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project2.AdminDashboardController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="50.0" layoutY="30.0" prefHeight="540.0" prefWidth="700.0" spacing="20.0">
         <children>
            <Label text="Admin Dashboard - User Role Management" textFill="#2699a1">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <Label text="Manage User Roles and Permissions" textFill="#666666">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <TableView fx:id="userTable" prefHeight="400.0" prefWidth="700.0">
              <columns>
                <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="Username" />
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="ageColumn" prefWidth="100.0" text="Age" />
                <TableColumn fx:id="roleColumn" prefWidth="150.0" text="Current Role" />
                <TableColumn fx:id="actionColumn" prefWidth="150.0" text="Change Role" />
              </columns>
            </TableView>
            
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshUserList" prefWidth="120.0" text="Refresh Users" />
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logout" prefWidth="120.0" text="Logout" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>