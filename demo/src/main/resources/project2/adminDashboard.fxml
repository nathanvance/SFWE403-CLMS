<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="adminDashboardPane"
            prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="project2.AdminDashboardController">

    <!-- Center the entire VBox inside the AnchorPane -->
    <VBox alignment="CENTER" spacing="20.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <Label text="Admin Dashboard - User Role Management" textFill="#2699a1">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>

        <Label text="Manage User Roles and Permissions" textFill="#666666">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>

        <TableView fx:id="userTable" prefHeight="300.0" maxHeight="900.0" minHeight="300.0" prefWidth="800.0" maxWidth="800.0"
                   minWidth="500.0">
            <columns>
                <TableColumn fx:id="usernameColumn" text="Username"/>
                <TableColumn fx:id="typeColumn" text="Type"/>
                <TableColumn fx:id="actionColumn" text="Actions"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="refreshButton" onAction="#refreshUserList" prefWidth="120.0"
                    text="Refresh Users"/>
            <Button fx:id="viewInventoryRequestsButton" onAction="#viewInventoryRequests"
                    text="📦 Inventory Requests"
                    style="-fx-background-color: #2699a1; -fx-text-fill: white;"/>

            <Button fx:id="changePasswordButton" text="Change Password" onAction="#goChangePassword"/>
            <Button fx:id="logoutButton" prefWidth="120.0" text="Logout" onAction="#logout"/>
            <Button fx:id="btnDeleteMyAccount" text="Delete My Account" onAction="#onDeleteMyAccount"/>
        </HBox>

    </VBox>
</AnchorPane>
